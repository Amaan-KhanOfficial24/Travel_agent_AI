# apps/api/.env.example — the list of settings the API needs, with NO real values.
# Copy it to .env (git-ignored) and fill values in there. Never put real keys in this file.
#
# Where real values live:
#   - Codespaces: GitHub → Settings → Codespaces → Secrets (injected as env vars)
#   - Deployed:   the hosting platform's environment-variable settings
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Format: postgres://<user>:<password>@<host>:<port>/<database>
# Local Docker database (docker-compose.yml, passwordless, localhost only):
#   postgres://app@localhost:5432/travel
DATABASE_URL=
DB_POOL_MAX=10

# Browser origins allowed to call the API with cookies (comma-separated)
CORS_ORIGINS=http://localhost:5173
SESSION_TTL_HOURS=168
# lax locally; "none" when frontend and API are on different sites (Stage 10)
COOKIE_SAMESITE=lax
# Number of reverse proxies in front of the API: 0 locally, 1 on Render
TRUST_PROXY_HOPS=0

# Login/register attempts per IP per 15 minutes
AUTH_RATE_LIMIT=10

# Duffel flights. In Codespaces set these as Codespaces SECRETS (see SETUP.md), not here.
# Test tokens start with duffel_test_. A live token is refused unless ALLOW_LIVE_BOOKINGS=true.
DUFFEL_ACCESS_TOKEN=
DUFFEL_BASE_URL=https://api.duffel.com
DUFFEL_SUPPLIER_TIMEOUT_MS=20000
ALLOW_LIVE_BOOKINGS=false

# Gemini AI assistant (free tier: Flash / Flash-Lite models)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Fare-change recovery guard rails
BOOKING_MAX_ATTEMPTS=3
BOOKING_MAX_INCREASE_PCT=25
